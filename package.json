{
  "name": "sunshine-padstal-ads",
  "version": "1.0.0",
  "description": "Batch product ad generator for Sunshine Padstal",
  "main": "dist-electron/main.js",
  "author": "Sunshine Padstal",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && vite build && tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:portable": "npm run build && electron-builder --win portable --config.win.target=portable --config.win.signAndEditExecutable=false --config.directories.output=release-single",
    "start": "electron ."
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "font-list": "^1.5.1",
    "node-fetch": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.2",
    "vite": "^8.0.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "co.za.sunshinepadstal.ads",
    "productName": "Sunshine Padstal Ads",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sunshine Padstal Ads",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ]
  }
}
